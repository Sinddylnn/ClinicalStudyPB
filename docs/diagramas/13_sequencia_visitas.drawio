        <mxCell id="cx-repo" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#17212B;align=center;verticalAlign=middle;spacing=4;" value="Repositórios&#xa;(JPA)" vertex="1"><mxGeometry height="70" width="190" x="1465" y="30" as="geometry" /></mxCell>
        <mxCell id="cx-bd" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#17212B;align=center;verticalAlign=middle;spacing=4;" value="PostgreSQL" vertex="1"><mxGeometry height="70" width="160" x="1720" y="30" as="geometry" /></mxCell>
        <mxCell id="100" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=16;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Pré-condição: o coordenador está vinculado ao estudo, que está em Recrutamento ou Execução, e o participante foi incluído (RF11).&#xa;A sessão (cookie JSESSIONID) e o token de GET /auth/csrf foram obtidos no login. Toda requisição passa pelo Spring Security&#xa;como no diagrama 08: sem sessão volta 401 AUTENTICACAO_NECESSARIA; token inválido, 403 CSRF_INVALIDO; perfil diferente de&#xa;COORDENADOR, 403 ACESSO_NEGADO. Estudo de outro coordenador, participação de outro estudo ou visita de outra participação&#xa;volta 404 RECURSO_NAO_ENCONTRADO. As datas são conferidas no fuso de Recife (America/Recife)." vertex="1"><mxGeometry height="112" width="1900" x="20" y="120" as="geometry" /></mxCell>
        <mxCell id="101" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F6F9;strokeColor=#465867;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;" value="1. Agendamento de visita (RF12)" vertex="1"><mxGeometry height="34" width="1900" x="20" y="266" as="geometry" /></mxCell>
        <mxCell id="102" edge="1" parent="1" style="edgeStyle=none;html=0;rounded=0;strokeColor=#465867;strokeWidth=2;endArrow=block;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="77" y="369" as="sourcePoint" /><mxPoint x="253" y="369" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="103" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=center;verticalAlign=bottom;spacing=2;labelBackgroundColor=#FFFFFF;" value="escolhe a visita&#xa;prevista,&#xa;a data e a hora" vertex="1"><mxGeometry height="59" width="155" x="87" y="308" as="geometry" /></mxCell>
        <mxCell id="104" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#465867;strokeWidth=2;endArrow=block;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="267" y="393" as="sourcePoint" /><mxPoint x="267" y="431" as="targetPoint" /><Array as="points"><mxPoint x="301" y="393" /><mxPoint x="301" y="431" /></Array></mxGeometry></mxCell>
        <mxCell id="105" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacing=2;labelBackgroundColor=#FFFFFF;" value="valida no navegador: visita prevista obrigatória,&#xa;data a partir de hoje e dentro do período do estudo" vertex="1"><mxGeometry height="42" width="442" x="309" y="391" as="geometry" /></mxCell>
        <mxCell id="106" edge="1" parent="1" style="edgeStyle=none;html=0;rounded=0;strokeColor=#465867;strokeWidth=2;endArrow=block;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="267" y="529" as="sourcePoint" /><mxPoint x="683" y="529" as="targetPoint" /></mxGeometry></mxCell>
