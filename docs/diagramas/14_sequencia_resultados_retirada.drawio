        <mxCell id="cx-bd" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#17212B;align=center;verticalAlign=middle;spacing=4;" value="PostgreSQL" vertex="1"><mxGeometry height="70" width="160" x="1720" y="30" as="geometry" /></mxCell>
        <mxCell id="100" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=16;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Pré-condição: o coordenador está vinculado ao estudo e o participante foi incluído (RF11). A sessão (cookie JSESSIONID) e o&#xa;token de GET /auth/csrf foram obtidos no login. Toda requisição passa pelo Spring Security como no diagrama 08: sem sessão&#xa;volta 401 AUTENTICACAO_NECESSARIA; token inválido, 403 CSRF_INVALIDO; perfil diferente de COORDENADOR, 403 ACESSO_NEGADO.&#xa;Estudo de outro coordenador, participação de outro estudo, visita de outra participação ou resultado de outra visita volta&#xa;404 RECURSO_NAO_ENCONTRADO. Controllers: VisitaAgendada, ResultadoAtividade e RetiradaParticipante; services de mesmo nome." vertex="1"><mxGeometry height="112" width="1900" x="20" y="120" as="geometry" /></mxCell>
        <mxCell id="101" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F6F9;strokeColor=#465867;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;" value="1. Abertura da tela de resultados de uma visita realizada (RF14)" vertex="1"><mxGeometry height="34" width="1900" x="20" y="266" as="geometry" /></mxCell>
