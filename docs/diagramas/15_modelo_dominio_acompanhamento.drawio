        <mxCell id="note-scope" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Complementa os diagramas de Estudos e Protocolo e de Recrutamento e Inclusão (11). Estudo, Protocolo, VisitaPrevista, AtividadePrevista e Usuario aparecem como contexto; Participacao mostra os campos da inclusão (V6 e V9) e do acompanhamento (V11); os pedidos do participante (RF19 e RF20) vêm da V12." vertex="1">
          <mxGeometry height="120" width="560" x="485.5" y="100" as="geometry" />
        </mxCell>
        <mxCell id="note-user" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Usuario também é referenciado por retiradaPor, registradoPor, atualizadoPor, corrigidaPor e respondidaPor. A conta da participação deve estar ativa e ter perfil PARTICIPANTE." vertex="1">
          <mxGeometry height="186" width="265.5" x="67.25" y="1282" as="geometry" />
        </mxCell>
        <mxCell id="note-participation" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="RETIRADA é irreversível: preserva a inclusão e o histórico, cancela as visitas agendadas e os pedidos de reagendamento pendentes, conclui o pedido de retirada pendente e não libera a vaga." vertex="1">
          <mxGeometry height="150" width="340" x="545.5" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="note-visit" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Regras estruturais: uma única visita AGENDADA por participação e visita prevista; um resultado por visita e atividade. Resultado só existe em visita REALIZADA, e a atividade deve pertencer à visita prevista da visita agendada. Correções nunca voltam a AGENDADA. Estes vínculos são validados no serviço." vertex="1">
          <mxGeometry height="186" width="340" x="1565.5" y="1346" as="geometry" />
        </mxCell>
