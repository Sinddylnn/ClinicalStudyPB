        <mxCell id="104" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#465867;strokeWidth=2;endArrow=block;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="267" y="354" as="sourcePoint" /><mxPoint x="267" y="392" as="targetPoint" /><Array as="points"><mxPoint x="301" y="354" /><mxPoint x="301" y="392" /></Array></mxGeometry></mxCell>
