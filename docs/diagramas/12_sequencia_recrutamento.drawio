        <mxCell id="100" parent="1" style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=16;fillColor=#FFFFFF;strokeColor=#465867;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="Pré-condição: o coordenador está vinculado ao estudo, que está em Recrutamento com o protocolo definido, e a sessão (cookie JSESSIONID)&#xa;e o token em GET /auth/csrf foram obtidos no login. Toda requisição passa pelo Spring Security como no diagrama 08: sem sessão volta&#xa;401 AUTENTICACAO_NECESSARIA; token inválido, 403 CSRF_INVALIDO; perfil diferente de COORDENADOR, 403 ACESSO_NEGADO.&#xa;Estudo de outro coordenador ou candidato de outro estudo volta 404 RECURSO_NAO_ENCONTRADO, sem revelar se existem." vertex="1"><mxGeometry height="92" width="2020" x="20" y="120" as="geometry" /></mxCell>
        <mxCell id="101" parent="1" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F6F9;strokeColor=#465867;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#17212B;align=left;verticalAlign=middle;spacingLeft=12;" value="1. Cadastro do candidato (RF08)" vertex="1"><mxGeometry height="34" width="2020" x="20" y="246" as="geometry" /></mxCell>
        <mxCell id="102" edge="1" parent="1" style="edgeStyle=none;html=0;rounded=0;strokeColor=#465867;strokeWidth=2;endArrow=block;endFill=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="77" y="330" as="sourcePoint" /><mxPoint x="253" y="330" as="targetPoint" /></mxGeometry></mxCell>
