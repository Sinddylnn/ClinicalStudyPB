# <-------------------PORTAS NO COMPUTADOR------------------->
# Copie para .env na raiz para personalizar a execução pelo Compose
# Sem .env, o Compose usa estes mesmos valores padrão
SERVER_PORT=8080
WEB_PORT=5173
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# <-------------------POSTGRESQL LOCAL------------------->
# Credenciais fictícias exclusivas do desenvolvimento acadêmico
# Em volume já existente, use a senha com a qual o banco foi criado
SPRING_DATASOURCE_USERNAME=clinicalstudypb
SPRING_DATASOURCE_PASSWORD=clinicalstudypb_dev

# <-------------------BACKEND FORA DO DOCKER------------------->
# Referência para terminal/IDE; Spring Boot não carrega este arquivo sozinho
# Se POSTGRES_PORT mudar, ajuste esta URL ao executar Java fora do Docker
# Dentro do Docker, o Compose fornece jdbc:postgresql://db:5432/clinicalstudypb
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinicalstudypb

# <-------------------ACESSO WEB E SESSÃO------------------->
# Por padrão o Compose monta a origem a partir de WEB_PORT
# Descomente somente se precisar substituir essa origem
# WEB_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
