# <-------------------SERVIDOR LOCAL------------------->
# Referência das variáveis de ambiente, sem carregamento automático pelo Spring Boot
# Para usar outro valor, exporte SERVER_PORT no terminal ou configure na IDE
SERVER_PORT=8080

# <-------------------POSTGRESQL LOCAL------------------->
# Exemplo a alinhar com o Compose de Gabriela e o BD
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinicalstudypb
SPRING_DATASOURCE_USERNAME=clinicalstudypb
SPRING_DATASOURCE_PASSWORD=defina_a_senha_local

# <-------------------ACESSO WEB E SESSÃO------------------->
# Usar a mesma origem no navegador e na configuração, sem alternar localhost e 127.0.0.1
WEB_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
