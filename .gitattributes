# <-------------------FIM DE LINHA DOS ARQUIVOS------------------->

# Serve para não quebrar código ao rodar scripts do ruindows
# LF e CRLF são apenas maneiras diferentes que um SO identifica fim de linha e início da próxima
# LF -> \n  | CRLF -> \r\n são os caractere invisíveis
* text=auto
# padrão de quebra de linha universal do Unix
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
mvnw text eol=lf
 # padrão de quebra de linha do windows
*.cmd text eol=crlf